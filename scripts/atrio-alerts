#!/bin/bash
# Sends Atrio's warnings to a phone through ntfy, Gotify or Apprise, even when no browser has Atrio open.
# Run every 5 minutes by atrio-alerts.timer, and with --test by atrio-alerts-test.path when the
# settings ask for a test message. The settings are in alerts.conf, written by Atrio through the
# CasaOS file API: only the known keys are read, and their values are checked, never executed.
set -uo pipefail

STATE="${ATRIO_STATE:-/var/lib/casaos/atrio}"
CONF="$STATE/alerts.conf"
MEMORY="$STATE/alerts-memory"
STATUS="$STATE/alerts-status.json"
TEST_REQUEST="$STATE/alerts-test"
APPS="${ATRIO_APPS:-/var/lib/casaos/apps}"
WWW="${ATRIO_WWW:-/var/lib/casaos/www}"
SYS="${ATRIO_SYS:-/sys}"
REPO="peppeaiello/atrio"
MODE="${1:-}"

mkdir -p "$STATE"
# The settings hold the token of the push service: root only. Atrio reads and writes them as root too.
[ -f "$CONF" ] && chmod 600 "$CONF"

# One run at a time: the timer and a test could overlap
exec 9>"$STATE/alerts.lock"
flock -w 30 9 || exit 0

# --- Settings ---------------------------------------------------------------------------------

ENABLED=0 SERVICE=ntfy URL="https://ntfy.sh" TOPIC="" TOKEN="" LANGUAGE=en
DISK=1 HEALTH=1 TEMP=1 APPS_CHANGES=1 APP_UPDATES=1 UPDATES=1 APP_DOWN=1 DISK_LIMIT=90 TEMP_LIMIT=85
# Quiet hours hold back what is not urgent until they end; muted apps send nothing (their changes are still logged)
QUIET=0 QUIET_FROM=23:00 QUIET_TO=07:00 MUTE=""
QUEUE="$STATE/alerts-queue"

read_conf() {
	[ -f "$CONF" ] || return 0
	local key value
	while IFS='=' read -r key value; do
		value="${value%$'\r'}"
		case "$key" in
			ENABLED | DISK | HEALTH | TEMP | APPS | APP_UPDATES | UPDATES | APP_DOWN | QUIET)
				[[ "$value" =~ ^[01]$ ]] || continue
				[ "$key" = APPS ] && key=APPS_CHANGES
				printf -v "$key" '%s' "$value" ;;
			SERVICE) [[ "$value" =~ ^(ntfy|gotify|apprise)$ ]] && SERVICE="$value" ;;
			URL) [[ "$value" =~ ^https?://[A-Za-z0-9.:/_~%-]+$ ]] && URL="${value%/}" ;;
			TOPIC) [[ "$value" =~ ^[A-Za-z0-9_-]{1,64}$ ]] && TOPIC="$value" ;;
			TOKEN) [[ "$value" =~ ^[A-Za-z0-9._-]{0,128}$ ]] && TOKEN="$value" ;;
			LANGUAGE) [[ "$value" =~ ^(en|it)$ ]] && LANGUAGE="$value" ;;
			DISK_LIMIT) [[ "$value" =~ ^[5-9][0-9]$ ]] && DISK_LIMIT="$value" ;;
			TEMP_LIMIT) [[ "$value" =~ ^([6-9][0-9]|10[0-9]|110)$ ]] && TEMP_LIMIT="$value" ;;
			QUIET_FROM | QUIET_TO) [[ "$value" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] && printf -v "$key" '%s' "$value" ;;
			MUTE) [[ "$value" =~ ^[A-Za-z0-9_.,-]{0,2000}$ ]] && MUTE="$value" ;;
		esac
	done < "$CONF"
}

# --- What was already sent (key=value lines) -------------------------------------------------

memory_get() {
	sed -n "s/^$1=//p" "$MEMORY" 2>/dev/null | head -n 1
}

memory_set() {
	{ grep -v "^$1=" "$MEMORY" 2>/dev/null; printf '%s=%s\n' "$1" "$2"; } > "$MEMORY.tmp"
	mv "$MEMORY.tmp" "$MEMORY"
}

# Activity log, read by the web UI: "time<tab>action<tab>ok|error<tab>app<tab>detail", newest last
log_activity() {
	local line
	line=$(printf '%s\t%s\t%s\t%s\t%s' "$(date -Iseconds)" "$1" "$2" "$3" "$4" | tr -d '\000-\010\012-\037' | head -c 600)
	printf '%s\n' "$line" >> "$STATE/activity.log" 2>/dev/null
	chmod 644 "$STATE/activity.log" 2>/dev/null
}

# atrio-backup logs the updates it makes itself; the image change it leaves is the same update
recently_updated_here() {
	local since
	since=$(date -d '-30 min' +%s)
	tail -n 200 "$STATE/activity.log" 2>/dev/null | awk -F'\t' -v app="$1" -v since="$since" '
		$2 == "update-app" && $3 == "ok" && $4 == app { cmd = "date -d \"" $1 "\" +%s"; cmd | getline t; close(cmd); if (t >= since) found = 1 }
		END { exit !found }'
}

# Keeps the activity log to its last 1500 events
trim_activity() {
	local file="$STATE/activity.log"
	[ -f "$file" ] && [ "$(wc -l < "$file")" -gt 2000 ] || return 0
	tail -n 1500 "$file" > "$file.tmp" && chmod 644 "$file.tmp" && mv "$file.tmp" "$file"
}

# --- Messages ----------------------------------------------------------------------------------

text() {
	local id="$1"; shift
	if [ "$LANGUAGE" = it ]; then
		case "$id" in
			test_title) echo "Notifica di prova di Atrio" ;;
			test_body) echo "Se leggi questo messaggio, gli avvisi push funzionano." ;;
			disk_title) echo "Disco quasi pieno" ;;
			disk_body) echo "$1 è pieno al $2%. Libera spazio perché app e CasaOS continuino a funzionare." ;;
			health_title) echo "Problema di salute di un disco" ;;
			disk_watch) echo "Il disco $1 mostra i primi segni di problemi: tienilo d'occhio e controlla di avere i backup." ;;
			disk_replace) echo "Il disco $1 rischia di guastarsi presto: fai subito un backup dei dati e pensa a sostituirlo." ;;
			health_body) echo "Il disco $1 segnala un problema (SMART). Fai un backup dei dati e controlla il disco." ;;
			temp_title) echo "Processore caldo" ;;
			temp_body) echo "Il processore è a $1 °C. Controlla il raffreddamento e cosa sta girando." ;;
			installed_title) echo "App installata" ;;
			installed_body) echo "$1 è installata." ;;
			removed_title) echo "App rimossa" ;;
			removed_body) echo "$1 è stata rimossa." ;;
			app_updated_title) echo "App aggiornata" ;;
			app_updated_body) echo "$1 è stata aggiornata." ;;
			queue_title) echo "Durante le ore di silenzio" ;;
			queue_more) echo "… e altri $1." ;;
			down_title) echo "App non funzionante" ;;
			down_restarting) echo "$1 continua a riavviarsi." ;;
			down_crashed) echo "$1 si è fermata da sola (codice $2)." ;;
			down_unhealthy) echo "$1 segnala di non stare bene (controllo di salute)." ;;
			down_no_answer) echo "$1 è avviata ma la sua pagina non risponde." ;;
			up_title) echo "App di nuovo attiva" ;;
			up_body) echo "$1 funziona di nuovo." ;;
			backup_title) echo "Backup automatico non riuscito" ;;
			backup_body) echo "Il backup automatico di $1 non è riuscito: $2" ;;
			update_title) echo "Nuova versione di Atrio" ;;
			update_body) echo "È disponibile Atrio $1. Apri le impostazioni di Atrio per aggiornare." ;;
		esac
	else
		case "$id" in
			test_title) echo "Atrio test notification" ;;
			test_body) echo "If you can read this, push alerts work." ;;
			disk_title) echo "Disk almost full" ;;
			disk_body) echo "$1 is $2% full. Free some space to keep apps and CasaOS working." ;;
			health_title) echo "Disk health problem" ;;
			disk_watch) echo "Disk $1 shows the first signs of trouble: keep an eye on it and make sure you have backups." ;;
			disk_replace) echo "Disk $1 may fail soon: back up its data now and plan to replace it." ;;
			health_body) echo "Disk $1 reports a problem (SMART). Back up your data and check the disk." ;;
			temp_title) echo "Processor running hot" ;;
			temp_body) echo "The processor is at $1 °C. Check the cooling and what is running." ;;
			installed_title) echo "App installed" ;;
			installed_body) echo "$1 is installed." ;;
			removed_title) echo "App removed" ;;
			removed_body) echo "$1 was removed." ;;
			app_updated_title) echo "App updated" ;;
			app_updated_body) echo "$1 was updated." ;;
			queue_title) echo "During quiet hours" ;;
			queue_more) echo "… and $1 more." ;;
			down_title) echo "App down" ;;
			down_restarting) echo "$1 keeps restarting." ;;
			down_crashed) echo "$1 stopped on its own (exit code $2)." ;;
			down_unhealthy) echo "$1 reports it is not healthy (health check)." ;;
			down_no_answer) echo "$1 is running but its page does not answer." ;;
			up_title) echo "App working again" ;;
			up_body) echo "$1 is working again." ;;
			backup_title) echo "Automatic backup failed" ;;
			backup_body) echo "The automatic backup of $1 failed: $2" ;;
			update_title) echo "New Atrio version" ;;
			update_body) echo "Atrio $1 is available. Open Atrio's settings to update." ;;
		esac
	fi
}

# --- Sending -----------------------------------------------------------------------------------

LAST_SENT="" LAST_ERROR=""

# send TITLE MESSAGE PRIORITY(1-5) NTFY_TAGS
# Runs curl on a request; on failure leaves in $result what went wrong, with the server's own
# answer when there is one, so that a refusal reads as the reason instead of "error 400"
post() {
	local reply code
	reply=$(mktemp) || { result="Could not create a temporary file"; return 1; }
	code=$(curl -sS --connect-timeout 10 --max-time 20 -o "$reply" -w '%{http_code}' "$@" 2>"$reply.err")
	local status=$?
	if [ $status -eq 0 ] && [[ "$code" =~ ^2 ]]; then
		rm -f "$reply" "$reply.err"
		return 0
	fi
	if [ $status -ne 0 ]; then
		result=$(head -c 300 "$reply.err")
	else
		# Plain text, JSON or an HTML error page: tags removed, kept to one short line
		result="HTTP $code: $(head -c 4000 "$reply" | sed 's/<[^>]*>/ /g' | tr -s ' \t\r\n' ' ' | head -c 240)"
	fi
	rm -f "$reply" "$reply.err"
	return 1
}

# Whether now is within quiet hours, which can run past midnight
quiet_now() {
	[ "$QUIET" = 1 ] || return 1
	local now from to
	now=$((10#$(date +%H) * 60 + 10#$(date +%M)))
	from=$((10#${QUIET_FROM%:*} * 60 + 10#${QUIET_FROM#*:}))
	to=$((10#${QUIET_TO%:*} * 60 + 10#${QUIET_TO#*:}))
	if [ "$from" -le "$to" ]; then
		[ "$now" -ge "$from" ] && [ "$now" -lt "$to" ]
	else
		[ "$now" -ge "$from" ] || [ "$now" -lt "$to" ]
	fi
}

muted() {
	[[ ",$MUTE," == *",$1,"* ]]
}

# send TITLE MESSAGE PRIORITY(1-5) NTFY_TAGS: in quiet hours, what is not urgent (below 5) waits
# in the queue and goes out as one message when they end
send() {
	if [ "${4:-}" != bell ] && [ "$3" -lt 5 ] && quiet_now; then
		printf '%s\t%s\n' "$1" "$2" | tr -d '\r' >> "$QUEUE"
		chmod 600 "$QUEUE" 2>/dev/null
		return 0
	fi
	send_now "$@"
}

# What waited during quiet hours, in one message
flush_queue() {
	[ -s "$QUEUE" ] && ! quiet_now || return 0
	local count body
	count=$(wc -l < "$QUEUE")
	body=$(head -n 15 "$QUEUE" | awk -F'\t' '{ print "• " $1 ": " $2 }')
	[ "$count" -gt 15 ] && body="$body
$(text queue_more $((count - 15)))"
	send_now "$(text queue_title)" "$body" 3 "zzz" && rm -f "$QUEUE"
}

send_now() {
	local title="$1" message="$2" priority="$3" tags="$4" result=""
	if [ "$SERVICE" = gotify ]; then
		post -F "title=$title" -F "message=$message" -F "priority=$priority" "$URL/message?token=$TOKEN"
	elif [ "$SERVICE" = apprise ]; then
		# Apprise API: the key names a saved configuration, whose services all get the message
		local type=info
		[ "$priority" -ge 4 ] && type=warning
		[ "$priority" -ge 5 ] && type=failure
		post -H "Accept: application/json" --data-urlencode "title=$title" --data-urlencode "body=$message" \
			--data-urlencode "type=$type" "$URL/notify/$TOPIC"
	else
		local auth=()
		[ -n "$TOKEN" ] && auth=(-H "Authorization: Bearer $TOKEN")
		# ntfy reads the title from a header: RFC 2047 keeps accents intact
		post "${auth[@]}" -H "Title: =?UTF-8?B?$(printf '%s' "$title" | base64 -w0)?=" \
			-H "Priority: $priority" -H "Tags: $tags" --data-binary "$message" "$URL/$TOPIC"
	fi
	if [ $? -eq 0 ]; then
		LAST_SENT="$title"
		return 0
	fi
	LAST_ERROR="${result:-Could not reach $URL}"
	return 1
}

# --- Checks ------------------------------------------------------------------------------------

check_disks() {
	local mount used
	while read -r used mount; do
		used="${used%\%}"
		[[ "$used" =~ ^[0-9]+$ ]] || continue
		local key="disk_$(printf '%s' "$mount" | tr -c 'A-Za-z0-9' '_')"
		if [ "$used" -ge "$DISK_LIMIT" ]; then
			[ "$(memory_get "$key")" = 1 ] && continue
			send "$(text disk_title)" "$(text disk_body "$mount" "$used")" 4 "warning" && memory_set "$key" 1
		elif [ "$used" -lt $((DISK_LIMIT - 5)) ]; then
			memory_set "$key" 0
		fi
	done < <(df -P -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs 2>/dev/null |
		awk 'NR > 1 && $6 !~ "^/(boot|snap)" { print $5, $6 }')
}

# --- Disk health --------------------------------------------------------------------------------

DISKS_JSON="$STATE/disks.json"
DISKS_TSV="$STATE/disks.tsv"

# The SMART data of one disk as KEY=value lines, from smartctl's text output (ATA, SAT and NVMe)
smart_values() {
	awk '
		function num(s) { gsub(/,/, "", s); match(s, /^[0-9]+/); return RLENGTH > 0 ? substr(s, 1, RLENGTH) : "" }
		function after(s) { sub(/^[^:]*:[ \t]*/, "", s); return s }
		/^(Device Model|Model Number):/ { model = after($0) }
		/^Model Family:/ { family = after($0) }
		/^Serial Number:/ { serial = after($0) }
		/^(User Capacity|Total NVM Capacity|Namespace 1 Size\/Capacity):/ && !size { size = num(after($0)) }
		/^Rotation Rate:/ { kind = (after($0) ~ /Solid State/) ? "ssd" : "hdd" }
		/^SMART overall-health self-assessment test result:/ { health = after($0) }
		/^SMART Health Status:/ { health = after($0) }
		/^Critical Warning:/ { crit = after($0) }
		/^Temperature:/ { temp = num(after($0)) }
		/^Percentage Used:/ { used = num(after($0)) }
		/^Power On Hours:/ { hours = num(after($0)) }
		/^Media and Data Integrity Errors:/ { media = num(after($0)) }
		/^NVMe Version:|^Model Number:/ { kind = "nvme" }
		# ATA attributes: ID NAME FLAG VALUE WORST THRESH TYPE UPDATED WHEN_FAILED RAW
		$1 ~ /^[0-9]+$/ && NF >= 10 {
			raw = num($10)
			if ($1 == 5) realloc = raw
			else if ($1 == 9) hours = raw
			else if ($1 == 187 && unc == "") unc = raw
			else if ($1 == 188) timeout = raw
			else if ($1 == 194 || ($1 == 190 && temp == "")) temp = raw
			else if ($1 == 196 && realloc == "") realloc = raw
			else if ($1 == 197) pending = raw
			else if ($1 == 198) unc = raw
			else if ($1 == 199) crc = raw
			else if ($1 == 177 || $1 == 231 || $1 == 233) { if (used == "") used = 100 - num($4) }
			else if ($1 == 202) { if (used == "") used = raw }
		}
		END {
			if (model == "") model = family
			printf "MODEL=%s\nSERIAL=%s\nSIZE=%s\nKIND=%s\nHEALTH=%s\nCRIT=%s\nTEMP=%s\nUSED=%s\nHOURS=%s\n", model, serial, size, kind, health, crit, temp, used, hours
			printf "MEDIA=%s\nREALLOC=%s\nPENDING=%s\nUNC=%s\nCRC=%s\n", media, realloc, pending, unc, crc
		}'
}

smart_get() {
	printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -n 1
}

# good, watch or replace, then the reasons: the signs that, in Backblaze's statistics of their
# drives, go with a disk that fails soon (pending, uncorrectable and reallocated sectors), wear,
# and what is worth a look (cable errors, heat, age)
smart_verdict() {
	local v="$1" verdict=good reasons="" n
	add() { reasons="$reasons $1"; }
	n=$(smart_get "$v" HEALTH)
	[[ "$n" =~ FAIL ]] && { verdict=replace; add failed; }
	n=$(smart_get "$v" PENDING); [ "${n:-0}" -gt 0 ] && { verdict=replace; add pending; }
	n=$(smart_get "$v" UNC); [ "${n:-0}" -gt 0 ] && { verdict=replace; add uncorrectable; }
	n=$(smart_get "$v" MEDIA); [ "${n:-0}" -gt 0 ] && { verdict=replace; add media-errors; }
	n=$(smart_get "$v" CRIT); [[ "$n" =~ ^0x0*[1-9a-fA-F] ]] && { verdict=replace; add critical-warning; }
	n=$(smart_get "$v" USED); [ "${n:-0}" -ge 100 ] && { verdict=replace; add worn-out; }
	n=$(smart_get "$v" REALLOC)
	if [ "${n:-0}" -ge 100 ]; then verdict=replace; add reallocated-many
	elif [ "${n:-0}" -gt 0 ]; then [ "$verdict" = good ] && verdict=watch; add reallocated
	fi
	n=$(smart_get "$v" USED); [ "${n:-0}" -ge 80 ] && [ "${n:-0}" -lt 100 ] && { [ "$verdict" = good ] && verdict=watch; add wearing; }
	n=$(smart_get "$v" CRC); [ "${n:-0}" -gt 0 ] && { [ "$verdict" = good ] && verdict=watch; add cable; }
	local limit=55
	[ "$(smart_get "$v" KIND)" = nvme ] && limit=70
	n=$(smart_get "$v" TEMP); [ "${n:-0}" -ge "$limit" ] && { [ "$verdict" = good ] && verdict=watch; add hot; }
	[ "$(smart_get "$v" KIND)" = hdd ] && n=$(smart_get "$v" HOURS) && [ "${n:-0}" -ge 50000 ] && { [ "$verdict" = good ] && verdict=watch; add old; }
	[ -z "$(smart_get "$v" HEALTH)" ] && [ -z "$(smart_get "$v" TEMP)" ] && [ -z "$(smart_get "$v" HOURS)" ] && verdict=unknown
	printf '%s\t%s' "$verdict" "${reasons# }"
}

# Every hour: each disk smartctl can see, without waking one that sleeps (it keeps its last data).
# A verdict that gets worse is logged and sent; disks.json is what the hardware panel shows.
check_disk_health() {
	command -v smartctl >/dev/null || return 0
	local now last device type out code values verdict reasons serial key before rank_new rank_old line
	now=$(date +%s)
	last=$(memory_get disks_checked)
	[ -n "$last" ] && [ $((now - last)) -lt 3600 ] && [ -f "$DISKS_JSON" ] && return 0
	memory_set disks_checked "$now"
	touch "$DISKS_TSV"
	while read -r device _ type _; do
		[[ "$device" =~ ^/dev/[A-Za-z0-9/_-]+$ ]] && [[ "$type" =~ ^[A-Za-z0-9,_+-]+$ ]] || continue
		# In C: in other languages smartctl writes 1.234 for 1,234 and the numbers would be cut
		out=$(LC_ALL=C timeout 60 smartctl -n standby -i -H -A -d "$type" "$device" 2>/dev/null)
		code=$?
		# Asleep: the data of the last check stay
		[ $((code & 2)) -ne 0 ] && printf '%s' "$out" | grep -qi standby && continue
		values=$(printf '%s\n' "$out" | smart_values)
		line=$(smart_verdict "$values")
		verdict="${line%%$'\t'*}"
		reasons="${line#*$'\t'}"
		serial=$(smart_get "$values" SERIAL)
		key="disk_verdict_$(printf '%s' "${serial:-$device}" | tr -c 'A-Za-z0-9' '_')"
		before=$(memory_get "$key")
		memory_set "$key" "$verdict"
		rank_new=$(case "$verdict" in watch) echo 1 ;; replace) echo 2 ;; *) echo 0 ;; esac)
		rank_old=$(case "$before" in watch) echo 1 ;; replace) echo 2 ;; *) echo 0 ;; esac)
		if [ -n "$before" ] && [ "$rank_new" -gt "$rank_old" ]; then
			log_activity disk-health error "" "$verdict $device $reasons"
			if [ "${SEND_HEALTH:-1}" = 1 ]; then
				send "$(text health_title)" "$(text "disk_$verdict" "$device ($(smart_get "$values" MODEL))")" "$([ "$verdict" = replace ] && echo 5 || echo 4)" "rotating_light"
			fi
		fi
		{
			awk -F'\t' -v d="$device" '$1 != d' "$DISKS_TSV"
			# "-" for no reasons: read splits on tabs and would skip an empty field
			printf '%s\t%s\t%s\t%s\t%s\n' "$device" "$verdict" "${reasons:--}" "$(date -Iseconds)" "$(printf '%s' "$values" | tr '\n' '|')"
		} > "$DISKS_TSV.tmp"
		mv "$DISKS_TSV.tmp" "$DISKS_TSV"
	done < <(LC_ALL=C timeout 60 smartctl --scan-open 2>/dev/null | grep -v '^#')
	write_disks
}

write_disks() {
	local device verdict reasons checked values first=1 field key value
	{
		printf '{"time":"%s","disks":[' "$(date -Iseconds)"
		while IFS=$'\t' read -r device verdict reasons checked values; do
			[ -n "$device" ] || continue
			[ "$first" = 1 ] || printf ','
			first=0
			[ "$reasons" = - ] && reasons=""
			printf '{"device":"%s","verdict":"%s","reasons":"%s","checked":"%s"' "$device" "$verdict" "$reasons" "$checked"
			IFS='|' read -ra fields <<< "$values"
			for field in "${fields[@]}"; do
				key="${field%%=*}"
				value="${field#*=}"
				[[ "$key" =~ ^[A-Z]+$ ]] || continue
				printf ',"%s":"%s"' "$(printf '%s' "$key" | tr 'A-Z' 'a-z')" "$(json_text "$value")"
			done
			printf '}'
		done < "$DISKS_TSV"
		printf ']}\n'
	} > "$DISKS_JSON.tmp"
	chmod 644 "$DISKS_JSON.tmp"
	mv "$DISKS_JSON.tmp" "$DISKS_JSON"
}

cpu_temperature() {
	local hwmon best=0 value name
	for hwmon in "$SYS"/class/hwmon/hwmon*; do
		name=$(cat "$hwmon/name" 2>/dev/null) || continue
		case "$name" in coretemp* | k10temp* | zenpower* | cpu_thermal* | soc_thermal*) ;; *) continue ;; esac
		for value in "$hwmon"/temp*_input; do
			value=$(cat "$value" 2>/dev/null) || continue
			[[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -gt "$best" ] && best="$value"
		done
	done
	echo $((best / 1000))
}

check_temperature() {
	local temp
	temp=$(cpu_temperature)
	[ "$temp" -gt 0 ] || return 0
	if [ "$temp" -ge "$TEMP_LIMIT" ]; then
		[ "$(memory_get temp)" = 1 ] && return 0
		send "$(text temp_title)" "$(text temp_body "$temp")" 4 "fire" && memory_set temp 1
	elif [ "$temp" -lt $((TEMP_LIMIT - 10)) ]; then
		memory_set temp 0
	fi
}

# The name an app shows in CasaOS: x-casaos > title > en_us in its compose file
app_title() {
	local file="$APPS/$1/docker-compose.yml" title
	title=$(awk '/^x-casaos:/ { x = 1; next } /^[^ ]/ { x = 0 }
		x && /^  title:/ { t = 1; next } x && /^  [^ ]/ { t = 0 }
		t && /en_us:/ { sub(/^[^:]*: */, ""); gsub(/"/, ""); print; exit }' "$file" 2>/dev/null)
	echo "${title:-$1}"
}

check_apps() {
	[ -d "$APPS" ] || return 0
	local now before name
	now=$(find "$APPS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | tr '\n' ' ')
	before=$(memory_get apps)
	memory_set apps "$now"
	# The first run only takes note of what is installed; runs with app alerts off only log
	[ -n "$before" ] || return 0
	for name in $now; do
		[[ " $before " == *" $name "* ]] && continue
		log_activity app-installed ok "$name" ""
		[ "${SEND_APPS:-1}" = 1 ] && ! muted "$name" && send "$(text installed_title)" "$(text installed_body "$(app_title "$name")")" 3 "white_check_mark"
	done
	for name in $before; do
		[[ " $now " == *" $name "* ]] && continue
		log_activity app-removed ok "$name" ""
		[ "${SEND_APPS:-1}" = 1 ] && ! muted "$name" && send "$(text removed_title)" "$(text removed_body "$name")" 2 "wastebasket"
	done
}

# One service=image id for each running container of an app
app_images() {
	local ids
	ids=$(timeout 20 docker ps -q --filter "label=com.docker.compose.project=$1" 2>/dev/null)
	[ -n "$ids" ] || return 0
	timeout 20 docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}={{.Image}}' $ids 2>/dev/null |
		sort | tr '\n' ' '
}

# Whether a service in both lists runs another image: the tag alone says nothing for "latest"
images_changed() {
	local old new
	for new in $2; do
		for old in $1; do
			[ "${old%%=*}" = "${new%%=*}" ] && [ "$old" != "$new" ] && return 0
		done
	done
	return 1
}

check_app_updates() {
	command -v docker >/dev/null && [ -d "$APPS" ] || return 0
	local name now before
	for name in $(sed -n 's/^image_\([^=]*\)=.*/\1/p' "$MEMORY" 2>/dev/null); do
		# A removed app that comes back is an install, not an update
		[ -d "$APPS/$name" ] || sed -i "/^image_$name=/d" "$MEMORY"
	done
	for name in $(find "$APPS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'); do
		[[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || continue
		# A stopped app keeps what it ran before: an update made meanwhile shows when it starts
		now=$(app_images "$name")
		[ -n "$now" ] || continue
		before=$(memory_get "image_$name")
		if images_changed "$before" "$now"; then
			# Once per change, also when the alert has to be tried again
			if [ "$(memory_get "logged_$name")" != "$now" ]; then
				recently_updated_here "$name" || log_activity app-updated ok "$name" ""
				memory_set "logged_$name" "$now"
			fi
			if [ "${SEND_APPS:-1}" = 1 ] && ! muted "$name"; then
				send "$(text app_updated_title)" "$(text app_updated_body "$(app_title "$name")")" 3 "arrow_up" || continue
			fi
		fi
		memory_set "image_$name" "$now"
	done
}

# --- App health ---------------------------------------------------------------------------------

HEALTH_JSON="$STATE/health.json"

# A value from the x-casaos block of an app's compose file (port_map, scheme, index)
xcasaos() {
	awk -v key="$2" '
		/^x-casaos:/ { x = 1; level = -1; next }
		/^[^ ]/ { x = 0 }
		x && /^ +[^ ]/ {
			match($0, /^ */); n = RLENGTH
			if (level < 0) level = n
			if (n == level && index($0, key ":") == n + 1) {
				value = substr($0, n + length(key) + 2); gsub(/^ +| +$|["'"'"']/, "", value); print value; exit
			}
		}' "$APPS/$1/docker-compose.yml" 2>/dev/null
}

# How an app is doing: ok, stopped (by someone), restarting, crashed, unhealthy or no-answer,
# then a tab and a detail (the exit code of a crash)
app_condition() {
	local app="$1" ids line status code oom health restarts name stopped=0 running=0 total=0 before port scheme index url answer
	ids=$(timeout 20 docker ps -aq --filter "label=com.docker.compose.project=$app" 2>/dev/null)
	[ -n "$ids" ] || { printf 'none	'; return; }
	local all_restarts=0
	while read -r status code oom health restarts name; do
		[ -n "$status" ] || continue
		total=$((total + 1))
		all_restarts=$((all_restarts + ${restarts:-0}))
		case "$status" in
			restarting) printf 'restarting	'; return ;;
			running)
				running=$((running + 1))
				[ "$health" = unhealthy ] && { printf 'unhealthy	'; return; } ;;
			exited|dead)
				if [ "$oom" = true ] || ! [[ "$code" =~ ^(0|137|143)$ ]]; then
					printf 'crashed	%s' "$code"
					return
				fi
				stopped=$((stopped + 1)) ;;
		esac
	# shellcheck disable=SC2086
	done < <(timeout 20 docker inspect -f '{{.State.Status}} {{.State.ExitCode}} {{.State.OOMKilled}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} {{.RestartCount}} {{.Name}}' $ids 2>/dev/null)
	# Restarted again and again between two checks, even if it happens to be up right now
	before=$(memory_get "app_restarts_$app")
	memory_set "app_restarts_$app" "$all_restarts"
	if [ -n "$before" ] && [ $((all_restarts - before)) -ge 3 ]; then
		printf 'restarting	'
		return
	fi
	[ "$stopped" -eq "$total" ] && { printf 'stopped	'; return; }
	# Running: its page must answer, with anything (a login page, a 404 are fine)
	port=$(xcasaos "$app" port_map)
	if [ "$running" -eq "$total" ] && [[ "$port" =~ ^[0-9]{1,5}$ ]]; then
		scheme=$(xcasaos "$app" scheme)
		[[ "$scheme" =~ ^https?$ ]] || scheme=http
		url="$scheme://127.0.0.1:$port/"
		answer=$(curl -sk -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 15 "$url" 2>/dev/null)
		[ "${answer:-000}" = 000 ] && { printf 'no-answer	'; return; }
	fi
	printf 'ok	'
}

# Every installed app; a problem counts once it is seen twice in a row (ten minutes), so that a
# restart or an update is not taken for one. Skipped while atrio-backup stops apps on purpose.
check_app_health() {
	command -v docker >/dev/null && [ -d "$APPS" ] || return 0
	if [ -f "$STATE/backup.lock" ] && ! flock -n "$STATE/backup.lock" true 2>/dev/null; then
		return 0
	fi
	local app line condition detail shown count first=1 since title
	{
		printf '{"time":"%s","apps":{' "$(date -Iseconds)"
		for app in $(find "$APPS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort); do
			[[ "$app" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] && [ -f "$APPS/$app/docker-compose.yml" ] || continue
			line=$(app_condition "$app")
			condition="${line%%$'\t'*}"
			detail="${line#*$'\t'}"
			[ "$condition" = none ] && continue
			shown=$(memory_get "app_state_$app")
			case "$condition" in
				ok|stopped)
					memory_set "app_bad_$app" 0
					if [ -n "$shown" ] && [ "$shown" != ok ] && [ "$shown" != stopped ]; then
						log_activity app-up ok "$app" ""
						[ "${SEND_DOWN:-1}" = 1 ] && ! muted "$app" && send "$(text up_title)" "$(text up_body "$(app_title "$app")")" 3 "white_check_mark"
					fi
					shown="$condition"
					memory_set "app_since_$app" "$(date -Iseconds)" ;;
				*)
					count=$(( $(memory_get "app_bad_$app" || echo 0) + 1 ))
					memory_set "app_bad_$app" "$count"
					if [ "$count" -ge 2 ] && [ "$shown" != "$condition" ]; then
						title=$(app_title "$app")
						log_activity app-down error "$app" "$condition $detail"
						if [ "${SEND_DOWN:-1}" = 1 ] && ! muted "$app"; then
							case "$condition" in
								restarting) send "$(text down_title)" "$(text down_restarting "$title")" 4 "warning" ;;
								crashed) send "$(text down_title)" "$(text down_crashed "$title" "$detail")" 4 "warning" ;;
								unhealthy) send "$(text down_title)" "$(text down_unhealthy "$title")" 4 "warning" ;;
								no-answer) send "$(text down_title)" "$(text down_no_answer "$title")" 4 "warning" ;;
							esac
						fi
						shown="$condition"
						memory_set "app_since_$app" "$(date -Iseconds)"
					fi
					# Until it counts, the tile keeps what it showed
					[ -n "$shown" ] || shown=ok ;;
			esac
			memory_set "app_state_$app" "$shown"
			[ "$first" = 1 ] || printf ','
			first=0
			printf '"%s":{"state":"%s","since":"%s","detail":"%s"}' "$app" "$shown" "$(memory_get "app_since_$app")" "$(json_text "$detail")"
		done
		printf '}}\n'
	} > "$HEALTH_JSON.tmp"
	chmod 644 "$HEALTH_JSON.tmp"
	mv "$HEALTH_JSON.tmp" "$HEALTH_JSON"
}

# Automatic backups that failed, each one once (atrio-backup writes the result in schedules/)
check_backups() {
	local file name error time
	for file in "$STATE/schedules"/*; do
		[ -f "$file" ] || continue
		name=$(basename "$file")
		[[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] && [[ "$name" != *.tmp ]] || continue
		error=$(sed -n 's/^LAST_ERROR=//p' "$file" | head -n 1 | head -c 200)
		time=$(sed -n 's/^LAST_TIME=//p' "$file" | head -n 1)
		[ -n "$error" ] && [ -n "$time" ] || continue
		[ "$(memory_get "backup_$name")" = "$time" ] && continue
		send "$(text backup_title)" "$(text backup_body "$(app_title "$name")" "$error")" 4 "warning" && memory_set "backup_$name" "$time"
	done
}

check_updates() {
	# GitHub is asked every 6 hours at most
	local last now latest installed
	last=$(memory_get update_checked)
	now=$(date +%s)
	[ -n "$last" ] && [ $((now - last)) -lt 21600 ] && return 0
	memory_set update_checked "$now"
	latest=$(curl -fsS --max-time 20 "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null |
		sed -n 's/.*"tag_name" *: *"v\{0,1\}\([^"]*\)".*/\1/p' | head -n 1)
	installed=$(sed -n 's/.*"version" *: *"\([^"]*\)".*/\1/p' "$WWW/atrio-version.json" 2>/dev/null)
	[ -n "$latest" ] && [ -n "$installed" ] || return 0
	[ "$latest" = "$installed" ] && return 0
	# Only newer versions: the highest of the two must be the latest
	[ "$(printf '%s\n%s\n' "$installed" "$latest" | sort -V | tail -n 1)" = "$latest" ] || return 0
	[ "$(memory_get update_sent)" = "$latest" ] && return 0
	send "$(text update_title)" "$(text update_body "$latest")" 3 "arrow_up" && memory_set update_sent "$latest"
}

# --- Status for the settings -------------------------------------------------------------------

json_text() {
	printf '%s' "$1" | tr -d '"\\' | tr '\n\r\t' '   ' | cut -c1-200
}

write_status() {
	printf '{"state":"%s","message":"%s","last_sent":"%s","token":"%s","time":"%s"}\n' \
		"$1" "$(json_text "$2")" "$(json_text "$LAST_SENT")" "$REQUEST_TOKEN" "$(date -Iseconds)" > "$STATUS.tmp"
	mv "$STATUS.tmp" "$STATUS"
}

# --- Main --------------------------------------------------------------------------------------

configured() {
	if [ "$SERVICE" = gotify ]; then [ -n "$TOKEN" ]; else [ -n "$TOPIC" ]; fi
}

read_conf
REQUEST_TOKEN=""
trim_activity

if [ "$MODE" = "--test" ]; then
	# The request carries a token so the settings recognise the answer to their own test
	[ -f "$TEST_REQUEST" ] && REQUEST_TOKEN=$(head -c 64 "$TEST_REQUEST" | tr -cd 'A-Za-z0-9-')
	rm -f "$TEST_REQUEST"
	if ! configured; then
		write_status error "Not set up yet"
		exit 1
	fi
	if send_now "$(text test_title)" "$(text test_body)" 3 "bell"; then
		write_status ok "Test sent"
	else
		write_status error "$LAST_ERROR"
		exit 1
	fi
	exit 0
fi

if [ "$ENABLED" != 1 ] || ! configured; then
	# Keep the app list current, so turning alerts on later does not announce every app or update
	SEND_APPS=0 check_apps
	SEND_APPS=0 check_app_updates
	# The tiles show how apps are doing, and the hardware panel the disks, also with alerts off
	SEND_DOWN=0 check_app_health
	SEND_HEALTH=0 check_disk_health
	write_status disabled ""
	exit 0
fi

[ "$DISK" = 1 ] && check_disks
if [ "$HEALTH" = 1 ]; then check_disk_health; else SEND_HEALTH=0 check_disk_health; fi
[ "$TEMP" = 1 ] && check_temperature
if [ "$APPS_CHANGES" = 1 ]; then check_apps; else SEND_APPS=0 check_apps; fi
if [ "$APP_UPDATES" = 1 ]; then check_app_updates; else SEND_APPS=0 check_app_updates; fi
[ "$UPDATES" = 1 ] && check_updates
if [ "$APP_DOWN" = 1 ]; then check_app_health; else SEND_DOWN=0 check_app_health; fi
check_backups
flush_queue

if [ -n "$LAST_ERROR" ]; then
	write_status error "$LAST_ERROR"
else
	write_status ok ""
fi
