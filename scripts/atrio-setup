#!/bin/bash
# Installs Atrio's services on the server from a folder that holds this release's scripts:
# the updater, push alerts and backups in /usr/local/bin, the public release key, and their
# systemd units. Run as root by install.sh, and by atrio-update after it checked the signature of
# the release, so that updating from the settings brings the services of the new version too.
#
#   atrio-setup DIR [--update]
set -euo pipefail

SRC="${1:-}"
MODE="${2:-}"
# Another root folder, for the tests in tests/server only
ROOT="${ATRIO_ROOT:-}"
[ -n "$SRC" ] && [ -d "$SRC" ] || { echo "Usage: atrio-setup DIR [--update]" >&2; exit 1; }
[ -n "$ROOT" ] || [ "$(id -u)" -eq 0 ] || { echo "atrio-setup must run as root" >&2; exit 1; }
for file in atrio-update atrio-alerts atrio-backup atrio-release-key.gpg; do
	[ -f "$SRC/$file" ] && [ ! -L "$SRC/$file" ] || { echo "Missing $file in $SRC" >&2; exit 1; }
done

# Progress for the person watching; a terminal that went away (the web terminal closes with the
# gateway) must not stop the setup half way
trap '' HUP
say() {
	echo "$@" 2>/dev/null || true
}

# Each file is written next to the old one, then moved in place: a script that is running (the
# updater replaces itself) keeps reading its old copy
install_script() {
	cp "$SRC/$1" "$ROOT/usr/local/bin/$1.tmp"
	chown root:root "$ROOT/usr/local/bin/$1.tmp"
	chmod 755 "$ROOT/usr/local/bin/$1.tmp"
	mv "$ROOT/usr/local/bin/$1.tmp" "$ROOT/usr/local/bin/$1"
}

# The public key that releases are signed with: the updater installs only what it signed
mkdir -p "$ROOT"/usr/local/share/atrio
cp "$SRC/atrio-release-key.gpg" "$ROOT"/usr/local/share/atrio/release-key.gpg.tmp
chmod 644 "$ROOT"/usr/local/share/atrio/release-key.gpg.tmp
mv "$ROOT"/usr/local/share/atrio/release-key.gpg.tmp "$ROOT"/usr/local/share/atrio/release-key.gpg

# Updater: Atrio writes $STATE/update-request through the CasaOS file API,
# the path unit sees it and runs atrio-update as root.
install_script atrio-update
# Push alerts: checks the server every 5 minutes and sends warnings to ntfy, Gotify or Apprise,
# as set in Atrio's settings ($STATE/alerts.conf)
install_script atrio-alerts
install_script atrio-backup

say "Setting up their services..."
cat > "$ROOT"/etc/systemd/system/atrio-update.service <<'UNIT'
[Unit]
Description=Install the latest Atrio web UI for CasaOS

[Service]
Type=oneshot
ExecStart=/usr/local/bin/atrio-update
TimeoutStartSec=10min
UNIT

cat > "$ROOT"/etc/systemd/system/atrio-update.path <<'UNIT'
[Unit]
Description=Watch for update requests from the Atrio web UI

[Path]
PathExists=/var/lib/casaos/atrio/update-request

[Install]
WantedBy=multi-user.target
UNIT

# CasaOS updates put their own UI back: this puts Atrio back after them
cat > "$ROOT"/etc/systemd/system/atrio-restore.service <<'UNIT'
[Unit]
Description=Put Atrio back after a CasaOS update replaces the web UI

[Service]
Type=oneshot
ExecStart=/usr/local/bin/atrio-update --restore
TimeoutStartSec=10min
UNIT

cat > "$ROOT"/etc/systemd/system/atrio-restore.path <<'UNIT'
[Unit]
Description=Watch the CasaOS web UI for updates that replace Atrio

[Path]
PathChanged=/var/lib/casaos/www/index.html

[Install]
WantedBy=multi-user.target
UNIT

cat > "$ROOT"/etc/systemd/system/atrio-alerts.service <<'UNIT'
[Unit]
Description=Send Atrio's warnings to ntfy, Gotify or Apprise
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/atrio-alerts
TimeoutStartSec=3min
UNIT

cat > "$ROOT"/etc/systemd/system/atrio-alerts.timer <<'UNIT'
[Unit]
Description=Check the server for Atrio's push alerts every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
UNIT

# "Send a test" in the settings writes $STATE/alerts-test
cat > "$ROOT"/etc/systemd/system/atrio-alerts-test.service <<'UNIT'
[Unit]
Description=Send a test push alert for Atrio

[Service]
Type=oneshot
ExecStart=/usr/local/bin/atrio-alerts --test
TimeoutStartSec=1min
UNIT

cat > "$ROOT"/etc/systemd/system/atrio-alerts-test.path <<'UNIT'
[Unit]
Description=Watch for test requests from Atrio's push alert settings

[Path]
PathExists=/var/lib/casaos/atrio/alerts-test

[Install]
WantedBy=multi-user.target
UNIT

# App backups: Atrio writes $STATE/backup-request, the same way as the updater
cat > "$ROOT"/etc/systemd/system/atrio-backup.service <<'UNIT'
[Unit]
Description=Back up or restore an app for Atrio
# Several operations in a row are normal here: no limit on starts
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/bin/atrio-backup
TimeoutStartSec=infinity
UNIT

cat > "$ROOT"/etc/systemd/system/atrio-backup.path <<'UNIT'
[Unit]
Description=Watch for backup requests from Atrio
StartLimitIntervalSec=0

[Path]
PathExists=/var/lib/casaos/atrio/backup-request

[Install]
WantedBy=multi-user.target
UNIT

# Automatic backups and updates: every 15 minutes, the apps whose planned time has come get their backup,
# and once a night the apps chosen for it get their newer images
cat > "$ROOT"/etc/systemd/system/atrio-backup-schedule.service <<'UNIT'
[Unit]
Description=Make Atrio's automatic app backups and updates
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/atrio-backup --scheduled
TimeoutStartSec=infinity
UNIT

cat > "$ROOT"/etc/systemd/system/atrio-backup-schedule.timer <<'UNIT'
[Unit]
Description=Check for Atrio's automatic app backups and updates every 15 minutes

[Timer]
OnBootSec=5min
OnCalendar=*:0/15

[Install]
WantedBy=timers.target
UNIT

# New versions of apps on "latest": the registries are asked every 6 hours
cat > "$ROOT"/etc/systemd/system/atrio-check-updates.service <<'UNIT'
[Unit]
Description=Check the registries for new versions of the apps
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/atrio-backup --check-updates
TimeoutStartSec=30min
UNIT

cat > "$ROOT"/etc/systemd/system/atrio-check-updates.timer <<'UNIT'
[Unit]
Description=Check for new versions of the apps every 6 hours

[Timer]
OnBootSec=10min
OnUnitActiveSec=6h

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl reset-failed atrio-backup.path atrio-backup.service 2>/dev/null || true
systemctl enable --now atrio-update.path >/dev/null
systemctl enable --now atrio-restore.path >/dev/null
systemctl enable --now atrio-alerts.timer >/dev/null
systemctl enable --now atrio-alerts-test.path >/dev/null
systemctl enable --now atrio-backup.path >/dev/null
systemctl enable --now atrio-backup-schedule.timer >/dev/null
systemctl enable --now atrio-check-updates.timer >/dev/null
say "Starting push alerts and backups..."
# A first run writes the status the settings read (alerts stay off until set up there)
[ "$MODE" = "--update" ] || "$ROOT"/usr/local/bin/atrio-alerts || true
# Tells the web UI that backups are available
"$ROOT"/usr/local/bin/atrio-backup --init || true

# Atrio 0.1.28, withdrawn the day it came out, put its own build of the CasaOS core in place of
# /usr/bin/casaos (atrio-core). Atrio leaves CasaOS as it is: on the few servers that got it, the
# original it kept goes back, and atrio-core goes away. Nothing else of CasaOS is ever touched.
cleanup_core() {
	local state="${ATRIO_STATE:-$ROOT/var/lib/casaos/atrio}" casaos="${ATRIO_CASAOS_BIN:-$ROOT/usr/bin/casaos}"
	# Atrio's three cores of 0.1.28, and IceWhale's v0.4.15 for amd64, arm64 and armv7 (the tests name their own)
	local ours="${ATRIO_OLD_CORES:-83f78d27738ce24d7e6cf7075808d02500256b70f201cab5f92df60e32371540 c6c60bc849d4b3686492be79a9b062b4b04775baa51f73f1bf6f362ca9d66045 f710aafd4ed4051797fe100eb344d993c64e3c756acfd4bc86dc60c273b5a7e9}"
	local official="${ATRIO_OFFICIAL_CORES:-f7e39c308e3cc5c226c31b8971a8542007e577e45360514f87e7153f85a081da a9943f36f069d49057eb9aec34f1c4232c608f56751063095d7b8904f58a4883 99f7cef864668128c9e79923ab2a4db68f19c314b1d8bd65e01cd1b85e9ebefb}"
	local current original
	[ -e "$ROOT/usr/local/bin/atrio-core" ] || [ -d "$state/core" ] || return 0
	systemctl disable --now atrio-core.path >/dev/null 2>&1 || true
	rm -f "$ROOT"/etc/systemd/system/atrio-core.path "$ROOT"/etc/systemd/system/atrio-core.service \
		"$ROOT"/usr/local/bin/atrio-core "$ROOT"/usr/local/share/atrio/casaos-core
	systemctl daemon-reload
	current=$(sha256sum < "$casaos" 2>/dev/null | cut -d' ' -f1)
	original=$(sha256sum < "$state/core/casaos.original" 2>/dev/null | cut -d' ' -f1)
	if [ -n "$current" ] && [[ " $ours " == *" $current "* ]]; then
		if [ -z "$original" ] || [[ " $official " != *" $original "* ]]; then
			# Without IceWhale's binary to put back, the fixed core keeps running and the folder stays
			say "The original CasaOS core was not found: Atrio's build of it keeps running."
			return 0
		fi
		say "Putting the original CasaOS core back..."
		cp "$state/core/casaos.original" "$casaos.atrio-new" && chmod 755 "$casaos.atrio-new" && mv -f "$casaos.atrio-new" "$casaos" \
			|| { rm -f "$casaos.atrio-new"; say "The original CasaOS core could not be put back."; return 0; }
		systemctl restart casaos >/dev/null 2>&1 || true
	fi
	rm -rf "$state/core" "$state/core-status.json" "$state/core-request" "$state/core.lock"
}
cleanup_core
