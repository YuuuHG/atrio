#!/bin/bash
# Keeps the CasaOS core from crashing. CasaOS v0.4.15 stops several times a day ("fatal error: found
# pointer to free object", CasaOS issue #2581): its network statistics copy 120 bytes out of a 96 byte
# value, and the garbage collector trips on what comes after. Atrio builds the same version with that
# fixed (casaos-core/ in Atrio's repository) and this puts it in place of /usr/bin/casaos, only when
# that is IceWhale's own v0.4.15 binary. The original is kept, and goes back when the fix is turned
# off in the settings (connecting a new cloud drive needs it) or when Atrio is removed.
#
#   atrio-core [--apply]   puts the fixed core in place, when CasaOS is the official v0.4.15 and the fix is on
#   atrio-core --request   does what the settings asked in $STATE/core-request ("on" or "off")
#   atrio-core --restore   puts the original back and forgets the fix (uninstall.sh)
#
# Run as root: by atrio-setup, every 6 hours by atrio-check-updates.service (a download that failed,
# CasaOS installed again), and by atrio-core.path for the settings.
set -uo pipefail

STATE="${ATRIO_STATE:-/var/lib/casaos/atrio}"
CASAOS="${ATRIO_CASAOS_BIN:-/usr/bin/casaos}"
# What the release says about its fixed cores (written by scripts/release.sh, installed by atrio-setup)
MANIFEST="${ATRIO_CORE_MANIFEST:-/usr/local/share/atrio/casaos-core}"
DIR="$STATE/core"
ORIGINAL="$DIR/casaos.original"
# Set while the fix is turned off in the settings
OFF="$DIR/off"
# The fixed core that is in place now, and which processor it is for
INSTALLED="$DIR/installed"
TARGET="$DIR/target"
# A fixed core that did not stay up: not tried again until the next one, or until the fix is turned on by hand
FAILED="$DIR/failed"
STATUS="$STATE/core-status.json"
REQUEST="$STATE/core-request"
RELEASES="${ATRIO_CORE_URL:-https://github.com/peppeaiello/atrio/releases/download}"
# How many seconds CasaOS must stay up after a change for it to count as working
STEADY="${ATRIO_CORE_STEADY:-20}"

# IceWhale's v0.4.15 binaries, as in linux-<target>-casaos-v0.4.15.tar.gz of their release.
# The tests name their own: ATRIO_CORE_OFFICIAL="SHA256 TARGET"
official_target() {
	if [ -n "${ATRIO_CORE_OFFICIAL:-}" ]; then
		[ -n "$1" ] && [ "${ATRIO_CORE_OFFICIAL% *}" = "$1" ] && { echo "${ATRIO_CORE_OFFICIAL#* }"; return 0; }
		return 1
	fi
	case "$1" in
		f7e39c308e3cc5c226c31b8971a8542007e577e45360514f87e7153f85a081da) echo amd64 ;;
		a9943f36f069d49057eb9aec34f1c4232c608f56751063095d7b8904f58a4883) echo arm64 ;;
		99f7cef864668128c9e79923ab2a4db68f19c314b1d8bd65e01cd1b85e9ebefb) echo arm-7 ;;
		*) return 1 ;;
	esac
}

sum_of() {
	[ -f "$1" ] && [ ! -L "$1" ] && sha256sum < "$1" | cut -d' ' -f1
}

json_text() {
	local text="${1//\\/\\\\}"
	printf '%s' "${text//\"/\\\"}"
}

# write_status STATE [MESSAGE]: fixed, off, original, other, unavailable, failed or working
write_status() {
	mkdir -p "$STATE"
	printf '{"state":"%s","fix":"%s","message":"%s","time":"%s"}\n' "$1" "$(json_text "$FIX")" "$(json_text "${2:-}")" \
		"$(date -Iseconds)" > "$STATUS.tmp" && chmod 644 "$STATUS.tmp" && mv -f "$STATUS.tmp" "$STATUS"
}

# The same line as the other services write, for the Activity tab
log_activity() {
	local line
	line=$(printf '%s\t%s\t%s\t%s\t%s' "$(date -Iseconds)" "$1" "$2" "" "${3:-}" | tr -d '\000-\010\012-\037' | head -c 600)
	printf '%s\n' "$line" >> "$STATE/activity.log" 2>/dev/null
	chmod 644 "$STATE/activity.log" 2>/dev/null
}

# Reads the release's manifest: RELEASE, FIX and one SHA-256 per target. Only those keys, checked.
RELEASE="" FIX=""
declare -A WANT=()
read_manifest() {
	local key value
	[ -f "$MANIFEST" ] || return 1
	while IFS='=' read -r key value; do
		case "$key" in
			RELEASE) [[ "$value" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] && RELEASE="$value" ;;
			FIX) [[ "$value" =~ ^[0-9]+$ ]] && FIX="$value" ;;
			amd64|arm64|arm-7) [[ "$value" =~ ^[0-9a-f]{64}$ ]] && WANT[$key]="$value" ;;
		esac
	done < "$MANIFEST"
	[ -n "$RELEASE" ]
}

# Restarts CasaOS and waits for it to stay up for STEADY seconds in a row
restart_casaos() {
	local up=0 waited=0
	systemctl restart casaos >/dev/null 2>&1 || return 1
	while [ "$up" -lt "$STEADY" ]; do
		[ "$waited" -ge $((STEADY * 3)) ] && return 1
		sleep 1
		waited=$((waited + 1))
		if systemctl is-active --quiet casaos; then up=$((up + 1)); else up=0; fi
	done
}

# put_in_place FILE: replaces the CasaOS binary with FILE. Written next to it first, then moved, so that
# /usr/bin/casaos is never half written
put_in_place() {
	if cp "$1" "$CASAOS.atrio-new" && chmod 755 "$CASAOS.atrio-new" && mv -f "$CASAOS.atrio-new" "$CASAOS"; then
		return 0
	fi
	rm -f "$CASAOS.atrio-new"
	return 1
}

# Downloads the fixed core for TARGET into DOWNLOAD and checks it against the manifest
DOWNLOAD=""
fetch_core() {
	local target="$1" want="${WANT[$1]}"
	rm -f "$DIR"/.download.*
	DOWNLOAD=$(mktemp "$DIR/.download.XXXXXX") || return 1
	# A core is about 22 MB: anything that unpacks to more than 64 MB is cut, and then fails the hash
	curl -fsSL --proto '=https,file' --proto-redir '=https' --connect-timeout 15 --speed-limit 1024 --speed-time 60 \
		--max-time 1800 "$RELEASES/$RELEASE/casaos-core-linux-$target.gz" 2>/dev/null \
		| gzip -dc 2>/dev/null | head -c 67108864 > "$DOWNLOAD"
	if [ "${PIPESTATUS[0]}" -ne 0 ] || [ "$(sum_of "$DOWNLOAD")" != "$want" ]; then
		rm -f "$DOWNLOAD"
		DOWNLOAD=""
		return 1
	fi
}

# The target of a fixed core named in the manifest
manifest_target() {
	local target
	for target in "${!WANT[@]}"; do
		[ "${WANT[$target]}" = "$1" ] && { echo "$target"; return 0; }
	done
	return 1
}

# Puts IceWhale's binary back, when what runs now is the fixed core Atrio put there.
# restore_original [quiet]: quiet when it follows a failure, which is logged on its own
restore_original() {
	local current
	current=$(sum_of "$CASAOS")
	[ -n "$current" ] && [ "$current" = "$(cat "$INSTALLED" 2>/dev/null)" ] || return 0
	if ! official_target "$(sum_of "$ORIGINAL")" >/dev/null; then
		write_status failed "The original CasaOS core that Atrio kept is missing or damaged, so it could not be put back"
		return 1
	fi
	put_in_place "$ORIGINAL" || { write_status failed "The original CasaOS core could not be put back"; return 1; }
	rm -f "$INSTALLED"
	restart_casaos
	[ "${1:-}" = quiet ] || log_activity core-off ok
}

apply() {
	local current target ours=0 want
	current=$(sum_of "$CASAOS")
	if [ -z "$current" ]; then
		write_status other "CasaOS is not installed in $CASAOS"
		return 0
	fi
	if [ -s "$INSTALLED" ] && [ "$current" = "$(cat "$INSTALLED")" ]; then
		ours=1
		target=$(cat "$TARGET" 2>/dev/null)
	elif target=$(manifest_target "$current"); then
		# This release's own fixed core, though what Atrio wrote about it is gone
		ours=1
		mkdir -p "$DIR" && chmod 700 "$DIR"
		echo "$current" > "$INSTALLED"
		echo "$target" > "$TARGET"
	elif target=$(official_target "$current"); then
		# The original is running: what Atrio had put there was replaced by it (CasaOS installed again)
		rm -f "$INSTALLED"
	else
		# Another version of CasaOS, or a core changed by someone else: never touched. What Atrio kept of
		# v0.4.15 is of no use any more.
		rm -f "$INSTALLED" "$TARGET" "$ORIGINAL"
		write_status other "CasaOS is not the official v0.4.15 on this server, so its core was left as it is"
		return 0
	fi

	if [ -e "$OFF" ]; then
		[ "$ours" -eq 1 ] && { restore_original || return 1; }
		write_status off
		return 0
	fi
	want="${WANT[$target]:-}"
	if [ -z "$want" ]; then
		[ "$ours" -eq 1 ] && write_status fixed || write_status unavailable "This copy of Atrio has no fixed CasaOS core for this server"
		return 0
	fi
	if [ "$current" = "$want" ]; then
		write_status fixed
		return 0
	fi
	if [ "$ours" -eq 0 ] && [ "$want" = "$(cat "$FAILED" 2>/dev/null)" ]; then
		write_status failed "CasaOS did not stay up with the fixed core, so the original was put back"
		return 0
	fi

	write_status working
	mkdir -p "$DIR" && chmod 700 "$DIR"
	# The original, kept once: it is what goes back when the fix is turned off
	if [ "$ours" -eq 0 ] && [ "$(sum_of "$ORIGINAL")" != "$current" ]; then
		cp "$CASAOS" "$ORIGINAL.tmp" && [ "$(sum_of "$ORIGINAL.tmp")" = "$current" ] && mv -f "$ORIGINAL.tmp" "$ORIGINAL" || {
			rm -f "$ORIGINAL.tmp"
			write_status failed "There is not enough space to keep a copy of the original CasaOS core (about 7 MB in $STATE)"
			return 1
		}
	fi
	if ! fetch_core "$target"; then
		[ "$ours" -eq 1 ] && write_status fixed "A newer fixed core could not be downloaded; it is tried again later" \
			|| write_status failed "The fixed CasaOS core could not be downloaded; it is tried again later"
		return 1
	fi
	if ! put_in_place "$DOWNLOAD"; then
		rm -f "$DOWNLOAD"
		write_status failed "The fixed CasaOS core could not be put in place"
		return 1
	fi
	rm -f "$DOWNLOAD"
	echo "$want" > "$INSTALLED"
	echo "$target" > "$TARGET"
	if ! restart_casaos; then
		# Back to IceWhale's binary, and this fixed core is not tried again by itself
		echo "$want" > "$FAILED"
		restore_original quiet
		write_status failed "CasaOS did not stay up with the fixed core, so the original was put back"
		log_activity core-on error "CasaOS did not stay up with it"
		return 1
	fi
	rm -f "$FAILED"
	write_status fixed
	log_activity core-on ok "$FIX"
}

[ -n "${ATRIO_STATE:-}" ] || [ "$(id -u)" -eq 0 ] || { echo "atrio-core must run as root" >&2; exit 1; }
mkdir -p "$STATE"
# One run at a time: the setup, the timer and the settings can ask together
exec 9>"$STATE/core.lock"
flock -w 900 9 || exit 1
read_manifest

case "${1:---apply}" in
	--apply)
		apply
		;;
	--request)
		[ -f "$REQUEST" ] && [ ! -L "$REQUEST" ] || exit 0
		asked=$(head -c 16 "$REQUEST" | tr -d '[:space:]')
		rm -f "$REQUEST"
		mkdir -p "$DIR" && chmod 700 "$DIR"
		case "$asked" in
			off)
				touch "$OFF"
				apply
				;;
			on)
				# Turned on by hand: a fixed core that failed before gets another try
				rm -f "$OFF" "$FAILED"
				apply
				;;
		esac
		;;
	--restore)
		restore_original || exit 1
		rm -rf "$DIR" "$STATUS"
		;;
	*)
		echo "Usage: atrio-core [--apply | --request | --restore]" >&2
		exit 1
		;;
esac
