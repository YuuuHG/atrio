#!/usr/bin/env python3
"""A stand-in for curl in the tests: registries and push services, with no network.

Docker Compose's releases on GitHub fail as with no network; a file:// download stops halfway with
error 23 when $FAKE_DOCKER/disk-full exists.
Registry manifests (HEAD .../v2/<repo>/manifests/<tag>) answer with the digest in $FAKE_DOCKER/state.json
under remote["<host>/<repo>:<tag>"], or 404. Anything else (a push alert) is logged to sent.log and
answered 200, or 400 when the file push-fails exists.
"""
import json, os, re, shutil, sys

args = sys.argv[1:]
DIR = os.environ['FAKE_DOCKER']
url = next(a for a in reversed(args) if a.startswith(('http://', 'https://', 'file://')))
# Docker Compose's releases: the tests have no network (a test serves its own from a file:// URL)
if url.startswith('https://github.com/docker/compose/releases/'):
    with open(os.path.join(DIR, 'calls.log'), 'a') as log:
        log.write('curl ' + url + '\n')
    sys.stderr.write('curl: (6) Could not resolve host: github.com\n')
    sys.exit(6)
# A full disk: half the file is written, then curl stops (23, write error)
if url.startswith('file://') and '-o' in args and os.path.exists(os.path.join(DIR, 'disk-full')):
    data = open(url[len('file://'):], 'rb').read()
    open(args[args.index('-o') + 1], 'wb').write(data[:len(data) // 2])
    sys.exit(23)
# Local files (a release made by a test) go to the real curl
if url.startswith('file://'):
    here = os.path.dirname(os.path.abspath(__file__))
    path = os.pathsep.join(p for p in os.environ['PATH'].split(os.pathsep) if os.path.abspath(p) != here)
    real = shutil.which('curl', path=path)
    os.execv(real, ['curl'] + args)
m = re.match(r'https://([^/]+)/v2/(.+)/manifests/([^/]+)$', url)
if m:
    state = json.load(open(os.path.join(DIR, 'state.json')))
    digest = state.get('remote', {}).get(f'{m.group(1)}/{m.group(2)}:{m.group(3)}')
    if digest:
        sys.stdout.write(f'HTTP/1.1 200 OK\r\nDocker-Content-Digest: {digest}\r\n\r\n')
    else:
        sys.stdout.write('HTTP/1.1 404 Not Found\r\n\r\n')
    sys.exit(0)

# An app's own page: the answer set in state["pages"]["<port>"], or none at all
m = re.match(r'https?://127\.0\.0\.1:(\d+)/', url)
if m:
    state = json.load(open(os.path.join(DIR, 'state.json')))
    sys.stdout.write(str(state.get('pages', {}).get(m.group(1), '000')))
    sys.exit(0 if state.get('pages', {}).get(m.group(1)) else 7)

# Tailscale's daemon, through its local API: the state the fake tailscale reads
m = re.match(r'http://local-tailscaled\.sock/localapi/v0/(.+)$', url)
if m:
    with open(os.path.join(DIR, 'calls.log'), 'a') as log:
        log.write('localapi ' + args[args.index('-X') + 1] + ' ' + m.group(1) + ' ' + (args[args.index('--data') + 1] if '--data' in args else '') + '\n')
    if os.path.exists(os.path.join(DIR, 'ts-api-fails')):
        sys.exit(22)
    path = os.path.join(DIR, 'tailscale.json')
    ts = json.load(open(path)) if os.path.exists(path) else {'backend': 'NeedsLogin', 'auth': ''}
    call = m.group(1)
    data = json.loads(args[args.index('--data') + 1]) if '--data' in args else {}
    if call == 'prefs' and data.get('WantRunning') is True and ts['backend'] == 'Stopped':
        ts['backend'] = 'Running'
    elif call == 'prefs' and data.get('WantRunning') is False and ts['backend'] == 'Running':
        ts['backend'] = 'Stopped'
    elif call == 'login-interactive' and ts['backend'] == 'NeedsLogin' and not os.path.exists(os.path.join(DIR, 'ts-no-link')):
        ts['auth'] = 'https://login.tailscale.com/a/fake123'
    elif call == 'logout':
        ts = {'backend': 'NeedsLogin', 'auth': ''}
    json.dump(ts, open(path, 'w'))
    sys.exit(0)

# Tailscale's installer: a script that installs the fake tailscale, or fails
if url == 'https://tailscale.com/install.sh':
    with open(os.path.join(DIR, 'calls.log'), 'a') as log:
        log.write('curl ' + url + '\n')
    fails = os.path.exists(os.path.join(DIR, 'ts-install-fails'))
    open(args[args.index('-o') + 1], 'w').write('echo installing\n' + ('exit 1\n' if fails else 'rm -f "$FAKE_DOCKER/ts-missing"\n'))
    sys.exit(0)

with open(os.path.join(DIR, 'sent.log'), 'a') as log:
    log.write(' '.join(args) + '\n')
code = '400' if os.path.exists(os.path.join(DIR, 'push-fails')) else '200'
if '-o' in args:
    open(args[args.index('-o') + 1], 'w').write('{"error":"refused"}' if code == '400' else 'ok')
if '-w' in args:
    sys.stdout.write(code)
sys.exit(0)
