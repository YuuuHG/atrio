@@ -1,5 +1,10 @@
+// Changed by Atrio (https://github.com/peppeaiello/atrio): IOCountersStatFrom replaces the
+// unsafe.Pointer conversions that crashed CasaOS (https://github.com/IceWhaleTech/CasaOS/issues/2581).
+
 package model
 
+import "github.com/shirou/gopsutil/v3/net"
+
 type IOCountersStat struct {
 	Name        string `json:"name"`        // interface name
 	BytesSent   uint64 `json:"bytesSent"`   // number of bytes sent
@@ -15,3 +20,22 @@ type IOCountersStat struct {
 	State       string `json:"state"`
 	Time        int64  `json:"time"`
 }
+
+// IOCountersStatFrom copies the counters of a network interface field by field. Converting the
+// pointer instead read 120 bytes out of the 96 of net.IOCountersStat: State and Time got whatever
+// came after it, and the garbage collector crashed on the bad string pointer.
+func IOCountersStatFrom(n net.IOCountersStat) IOCountersStat {
+	return IOCountersStat{
+		Name:        n.Name,
+		BytesSent:   n.BytesSent,
+		BytesRecv:   n.BytesRecv,
+		PacketsSent: n.PacketsSent,
+		PacketsRecv: n.PacketsRecv,
+		Errin:       n.Errin,
+		Errout:      n.Errout,
+		Dropin:      n.Dropin,
+		Dropout:     n.Dropout,
+		Fifoin:      n.Fifoin,
+		Fifoout:     n.Fifoout,
+	}
+}
diff --git a/model/net_test.go b/model/net_test.go
new file mode 100644
index 0000000..b95827f
--- /dev/null
+++ b/model/net_test.go
@@ -0,0 +1,42 @@
+// Added by Atrio (https://github.com/peppeaiello/atrio): checks IOCountersStatFrom.
+
+package model
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/shirou/gopsutil/v3/net"
+)
+
+// Every field of gopsutil's counters must reach IOCountersStat with its value, so that a field added
+// to either struct is not silently dropped.
+func TestIOCountersStatFromCopiesEveryField(t *testing.T) {
+	var n net.IOCountersStat
+	src := reflect.ValueOf(&n).Elem()
+	for i := 0; i < src.NumField(); i++ {
+		switch f := src.Field(i); f.Kind() {
+		case reflect.String:
+			f.SetString("eth" + string(rune('0'+i)))
+		case reflect.Uint64:
+			f.SetUint(uint64(1000 + i))
+		default:
+			t.Fatalf("unexpected field %s of kind %s", src.Type().Field(i).Name, f.Kind())
+		}
+	}
+	item := IOCountersStatFrom(n)
+	dst := reflect.ValueOf(item)
+	for i := 0; i < src.NumField(); i++ {
+		name := src.Type().Field(i).Name
+		got := dst.FieldByName(name)
+		if !got.IsValid() {
+			t.Fatalf("IOCountersStat has no field %s", name)
+		}
+		if got.Interface() != src.Field(i).Interface() {
+			t.Errorf("%s = %v, want %v", name, got.Interface(), src.Field(i).Interface())
+		}
+	}
+	if item.State != "" || item.Time != 0 {
+		t.Errorf("State and Time must start empty, got %q and %d", item.State, item.Time)
+	}
+}
